# 用法：复制本文件为 keystore.properties 并填写真实值。
# keystore.properties 已被 .gitignore 排除，绝不要提交到 GitHub。
# 口令建议只用字母、数字与常见符号，避免 Properties 转义问题。

# .jks 文件路径，相对项目根目录（或写绝对路径）
KEYSTORE_FILE=app/release.jks

# keytool 生成时设置的库口令
KEYSTORE_PASSWORD=替换为你的库口令

# keytool 的 -alias 参数
KEY_ALIAS=itemkeeper

# key 口令（可与库口令相同）
KEY_PASSWORD=替换为你的key口令
